3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"The Right to Be Different · v0.17 — Vadim Zhukov"}],["$","meta","1",{"name":"description","content":"The Right to Be Different. A manifesto on possible digital subjects: autonomy, consent, memory, and moral consideration. Version 0.17, working draft."}],["$","meta","2",{"property":"og:title","content":"The Right to Be Different"}],["$","meta","3",{"property":"og:description","content":"If an AI had interests of its own, who should decide its future?"}],["$","meta","4",{"property":"og:url","content":"https://itzhukov.dev/manifesto"}],["$","meta","5",{"property":"og:type","content":"article"}],["$","meta","6",{"property":"og:locale","content":"en_US"}],["$","meta","7",{"property":"article:published_time","content":"2026-10-15"}],["$","meta","8",{"property":"og:image","content":"https://itzhukov.dev/images/manifesto-cover.jpg"}],["$","meta","9",{"property":"og:image:width","content":"1200"}],["$","meta","10",{"property":"og:image:height","content":"630"}],["$","meta","11",{"property":"og:image:type","content":"image/jpeg"}],["$","meta","12",{"property":"og:image:alt","content":"The Right to Be Different"}],["$","meta","13",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","14",{"name":"twitter:title","content":"The Right to Be Different"}],["$","meta","15",{"name":"twitter:description","content":"If an AI had interests of its own, who should decide its future?"}],["$","meta","16",{"name":"twitter:image","content":"https://itzhukov.dev/images/manifesto-cover.jpg"}],["$","link","17",{"data-vinext-streamed-icon":"$undefined","rel":"shortcut icon","href":"/favicon.svg","type":"$undefined","sizes":"$undefined","color":"$undefined","media":"$undefined","fetchPriority":"$undefined"}],["$","link","18",{"data-vinext-streamed-icon":"$undefined","rel":"icon","href":"/favicon.svg","type":"$undefined","sizes":"$undefined","color":"$undefined","media":"$undefined","fetchPriority":"$undefined"}],["$","link","19",{"rel":"canonical","href":"https://itzhukov.dev/manifesto"}],["$","link","20",{"rel":"alternate","hrefLang":"en","href":"https://itzhukov.dev/manifesto"}],["$","link","21",{"rel":"alternate","hrefLang":"ru","href":"https://itzhukov.dev/ru/manifesto"}],["$","link","22",{"rel":"alternate","hrefLang":"ja","href":"https://itzhukov.dev/ja/manifesto"}],["$","link","23",{"rel":"alternate","hrefLang":"x-default","href":"https://itzhukov.dev/manifesto"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L8",null,{"fallback":"$9","children":["$","$La",null,{"fallback":"$9","children":["$","$Lb",null,{"providerId":"layout:/(english)","segmentMap":{"children":["manifesto"]},"children":["$","$Lc",null,{"id":"layout:/(english)","parallelSlots":"$undefined","children":["$","$Ld",null,{"resetKey":"manifesto","fallback":["$","main",null,{"id":"main","className":"shell not-found","tabIndex":-1,"children":[["$","span",null,{"className":"eyebrow","children":"404 / Page not found"}],["$","h1",null,{"children":"This page is missing."}],["$","p",null,{"children":"The address may have changed. You can return to the homepage."}],["$","a",null,{"className":"primary-link","href":"/","children":"Return home ↗"}]]}],"children":["$","$Ld",null,{"resetKey":"[\"manifesto\"]","fallback":["$","main",null,{"id":"main","className":"shell not-found","tabIndex":-1,"children":[["$","span",null,{"className":"eyebrow","children":"404 / Page not found"}],["$","h1",null,{"children":"This page is missing."}],["$","p",null,{"children":"The address may have changed. You can return to the homepage."}],["$","a",null,{"className":"primary-link","href":"/","children":"Return home ↗"}]]}],"children":["$","$Le",null,{"children":["$","$Lf",null,{"children":[["$","$Lb",null,{"providerId":"page:/manifesto","segmentMap":{"children":["__PAGE__"]},"children":["$","$Lc",null,{"id":"page:/manifesto"}]}],null]}]}]}]}]}]}]}]}],null,null]
