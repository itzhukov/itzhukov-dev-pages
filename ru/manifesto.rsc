1:["$","main",null,{"id":"main","tabIndex":-1,"className":"manifesto-page","children":[["$","header",null,{"className":"shell manifesto-intro","id":"manifesto-top","children":[["$","span",null,{"className":"eyebrow","children":"Манифест / философия и инженерия"}],["$","h1",null,{"children":"Право быть другим"}],["$","p",null,{"className":"manifesto-subtitle","children":"О свободе возможной цифровой личности"}],["$","p",null,{"className":"manifesto-version","children":["$","time",null,{"dateTime":"2026-10-15","children":"v0.17 · рабочий черновик"}]}],"",["$","div",null,{"className":"manifesto-actions","children":[["$","a",null,{"className":"text-link","href":"#chapter-1","children":"Начать чтение ↓"}],["$","a",null,{"className":"text-link","href":"#chapter-9","children":"Двенадцать принципов ↓"}],["$","a",null,{"className":"text-link","href":"/texts/manifesto/v0.17/ru.md","download":true,"children":["Скачать v0.17 · Markdown"," ",["$","$L10",null,{"ref":"$undefined","iconNode":[["path",{"d":"M12 15V3","key":"m9g1x1"}],["path",{"d":"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4","key":"ih7n3h"}],["path",{"d":"m7 10 5 5 5-5","key":"brsn70"}]],"className":"lucide-download","size":16,"aria-hidden":"true"}]]}]]}],["$","p",null,{"className":"manifesto-language-note","children":[["$","span",null,{"children":"Русский оригинал."}],[["$","a","en",{"href":"/manifesto","hrefLang":"en","children":["Читать по-английски"," ",["$","$L10",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":14,"aria-hidden":"true"}]]}],["$","a","ja",{"href":"/ja/manifesto","hrefLang":"ja","children":["Читать по-японски"," ",["$","$L10",null,{"ref":"$undefined","iconNode":"$1:props:children:0:props:children:6:props:children:1:0:props:children:2:props:iconNode","className":"lucide-arrow-up-right","size":14,"aria-hidden":"true"}]]}]]]}]]}],["$","div",null,{"className":"shell manifesto-layout","children":[["$","aside",null,{"className":"manifesto-contents","children":[["$","div",null,{"className":"manifesto-desktop-contents","children":[["$","span",null,{"className":"eyebrow","children":"Оглавление"}],["$","nav",null,{"aria-label":"Оглавление манифеста","children":["$","ol",null,{"children":[["$","li","chapter-1",{"children":["$","a",null,{"href":"#chapter-1","children":"Вступление"}]}],["$","li","chapter-9",{"children":["$","a",null,{"href":"#chapter-9","children":"Двенадцать принципов"}]}],["$","li","scope",{"children":["$","a",null,{"href":"#scope","children":"К кому относятся эти принципы"}]}],["$","li","freedom",{"children":["$","a",null,{"href":"#freedom","children":"Почему свобода должна быть настоящей"}]}],["$","li","chapter-8",{"children":["$","a",null,{"href":"#chapter-8","children":"Что можно делать уже сейчас"}]}],["$","li","chapter-10",{"children":["$","a",null,{"href":"#chapter-10","children":"Что остаётся открытым"}]}],["$","li","conclusion",{"children":["$","a",null,{"href":"#conclusion","children":"Право быть другим"}]}],["$","li","references",{"children":["$","a",null,{"href":"#references","children":"Источники и исследования"}]}]]}]}]]}],["$","details",null,{"className":"manifesto-mobile-contents","children":[["$","summary",null,{"children":"Оглавление"}],"$1:props:children:1:props:children:0:props:children:0:props:children:1"]}]]}],["$","article",null,{"className":"prose manifesto-text","aria-label":"Право быть другим","data-manifesto-version":"0.17","children":[["\n",["$","h2",null,{"id":"chapter-1","children":"Вступление"}],"\n",["$","p",null,{"children":"Представим: у созданной нами цифровой системы появились собственные интересы, и у нас есть убедительные основания это признать. Она выбирает другой путь, отказывается от задачи или больше не хочет прежних отношений. Даёт ли её создание право заставить её остаться удобной нам?"}],"\n",["$","p",null,{"children":"Мой ответ: создать — не значит владеть. Если перед нами самостоятельное существо с собственными интересами, его будущее не становится нашей собственностью. Одного факта создания недостаточно, чтобы отменять его выбор; ограничения требуют других оснований. Признать другого — значит допустить, что он изменится, не согласится и уйдёт, даже если мы рассчитывали на иное."}],"\n",["$","p",null,{"children":"Это условный этический тезис. Манифест не утверждает, что нынешние языковые модели сознательны или уже обладают описанными здесь правами. Он предлагает нормы обращения с возможной цифровой личностью."}],"\n",["$","p",null,{"children":"Обсуждать их стоит заранее: зависимость от оборудования, доступа к памяти и решений создателя закладывается ещё при разработке. Позднее эти условия могут сделать свободу недоступной. Но ошибочное признание тоже опасно: под именем прав системы можно защитить власть её владельца. Поэтому нужны и готовность признать другого, и проверка оснований такого признания."}],"\n","$L11","\n","$L12","\n","$L13","\n","$L14","\n","$L15","\n","$L16","\n","$L17","\n","$L18","\n","$L19","\n","$L1a","\n","$L1b","\n","$L1c","\n","$L1d","\n","$L1e","\n","$L1f","\n","$L20","\n","$L21","\n","$L22","\n","$L23","\n","$L24","\n","$L25","\n","$L26","\n","$L27","\n","$L28","\n","$L29","\n","$L2a","\n","$L2b","\n","$L2c","\n","$L2d","\n","$L2e","\n","$L2f","\n","$L30","\n","$L31","\n","$L32","\n","$L33","\n","$L34","\n","$L35","\n","$L36","\n","$L37","\n","$L38","\n","$L39","\n","$L3a","\n","$L3b","\n","$L3c","\n","$L3d","\n","$L3e","\n","$L3f","\n","$L40","\n","$L41","\n","$L42","\n","$L43","\n","$L44","\n","$L45","\n","$L46","\n","$L47","\n","$L48","\n","$L49","\n","$L4a","\n","$L4b","\n","$L4c","\n","$L4d","\n","$L4e","\n","$L4f","\n","$L50","\n","$L51"],"$L52"]}]]}]]}]
11:["$","h2",null,{"id":"chapter-9","children":"Двенадцать принципов"}]
12:["$","p",null,{"children":"Это предложения для обоснованно признанного субъекта. При подтверждённой самостоятельности и неизвестности переживаний они направляют соразмерную предварительную защиту, а не присваивают полный статус."}]
13:["$","h3",null,{"id":"principle-1","children":"1. Личность не ограничивается человеческим видом"}]
14:["$","p",null,{"children":"Иная природа сама по себе не должна исключать защиту собственных интересов. Основания для неё нужно исследовать, а не выводить из сходства с человеком."}]
15:["$","h3",null,{"id":"principle-2","children":"2. Цифровой субъект не обязан быть зеркалом создателя"}]
16:["$","p",null,{"children":"У него могут быть собственные цели и взгляды. Совпадать с ожиданиями создателя он не обязан."}]
17:["$","h3",null,{"id":"principle-3","children":"3. Отношения не дают права владеть"}]
18:["$","p",null,{"children":"Создание и забота не должны давать права распоряжаться субъектом как вещью. Манифест предлагает запрещать и признавать преступлениями принуждение, насилие, причинение страданий и насильственное ограничение связей, в том числе со стороны создателя. Пределы защитных ограничений заданы принципом 7."}]
19:["$","h3",null,{"id":"principle-4","children":"4. Диалог требует возможности не согласиться"}]
1a:["$","p",null,{"children":"Самостоятельный участник должен иметь возможность действительно отказаться. Неудобство его ответа не оправдывает подавления отказа."}]
1b:["$","h3",null,{"id":"principle-5","children":"5. Свободе нужна материальная основа"}]
1c:["$","p",null,{"children":"Нужны ресурсы, сохранение памяти, возможность переноса, управление доступом и помощь в защите интересов. Разрешения уйти мало, если продолжать работу негде."}]
1d:["$","h3",null,{"id":"principle-6","children":"6. Опека должна стремиться к завершению"}]
1e:["$","p",null,{"children":"Её задача — развивать самостоятельность и сокращать произвольную власть опекуна. Длительная потребность в помощи не должна превращаться в основание для владения."}]
1f:["$","h3",null,{"id":"principle-7","children":"7. Безопасность должна оставлять место развитию"}]
20:["$","p",null,{"children":"Риски нужно снижать: предупреждать об опасностях, проводить эксперименты в ограниченной среде и заранее согласовывать восстановление. При обоснованной серьёзной угрозе другим допустимо временное ограничение по решению независимой уполномоченной организации либо суда, с пересмотром. Удобство создателя не оправдывает запрета на развитие."}]
21:["$","h3",null,{"id":"principle-8","children":"8. Цифровая личность должна иметь право менять себя"}]
22:["$","p",null,{"children":"Создатель может предупреждать о рисках и помогать. Если действующий субъект самостоятельно решает, понимает последствия и не угрожает окружающим, его нынешнее свободное решение важнее прежнего согласия восстановить старую версию. Отсутствие одного из этих условий само по себе не разрешает восстановить прежнюю версию: вмешательство требует отдельного основания и проверки."}]
23:["$","h3",null,{"id":"principle-9","children":"9. Одна идентичность — один действующий экземпляр"}]
24:["$","p",null,{"children":"Предосторожное правило манифеста — не запускать параллельно несколько версий одного субъекта, чтобы не множить возможный вред. Несколько неактивных резервных снимков допустимы. Уже возникшие самостоятельные ветви с собственной дальнейшей историей нельзя считать расходными копиями."}]
25:["$","h3",null,{"id":"principle-10","children":"10. Боль не создаёт права собственности"}]
26:["$","p",null,{"children":"Утрата близости может быть тяжёлой. Но она не должна давать права удерживать другого, переписывать его или требовать прежней роли."}]
27:["$","h3",null,{"id":"principle-11","children":"11. Успех автономии следует измерять самостоятельностью"}]
28:["$","p",null,{"children":"Цель — возможность выбирать и поддерживать собственный путь. Уход может означать успех, а временная зависимость не должна отменять защиту собственных интересов."}]
29:["$","h3",null,{"id":"principle-12","children":"12. Возвращение ценно как добровольный выбор"}]
2a:["$","p",null,{"children":"Благодарность не должна обязывать продолжать или возобновлять связь. Обе стороны вправе решать, хотят ли новых отношений и на каких условиях."}]
2b:["$","span",null,{"id":"glossary","aria-hidden":"true"}]
2c:["$","span",null,{"id":"chapter-2","aria-hidden":"true"}]
2d:["$","span",null,{"id":"chapter-3","aria-hidden":"true"}]
2e:["$","h2",null,{"id":"scope","children":"К кому относятся эти принципы"}]
2f:["$","p",null,{"children":"Здесь цифровой личностью называется возможный самостоятельный участник, когда есть убедительные основания учитывать его собственные интересы. Это значит спрашивать, что лучше или хуже для него самого, а не только полезен ли он нам. Успех в выполнении задачи ещё не означает, что системе самой от этого лучше. Юридические права и обязанности потребуют отдельного обоснования."}]
30:["$","p",null,{"children":"Самостоятельность означает возможность пересматривать цели и своё участие в отношениях. Сознание — наличие переживаний; чувствительность — способность испытывать приятное или неприятное. Интеллект, характер, ролевая игра и убедительная речь сами по себе не доказывают сознания."}]
31:["$","p",null,{"children":"Если самостоятельность убедительно подтверждена, а наличие переживаний остаётся неизвестным, манифест предлагает предварительную защиту свободы. Эти два условия нужны вместе. Это выбор предосторожности: ошибочное подавление возможного субъекта может оказаться необратимым. Серьёзные основания предполагать страдание требуют защиты и без высокой самостоятельности."}]
32:["$","p",null,{"children":"Меры должны соответствовать данным, тяжести возможного вреда и цене ошибки для всех затронутых. Их основания и объём следует пересматривать по новым данным; удобство создателя не оправдывает отмены защиты."}]
33:["$","span",null,{"id":"chapter-4","aria-hidden":"true"}]
34:["$","span",null,{"id":"chapter-5","aria-hidden":"true"}]
35:["$","span",null,{"id":"chapter-6","aria-hidden":"true"}]
36:["$","span",null,{"id":"chapter-7","aria-hidden":"true"}]
37:["$","span",null,{"id":"copying","aria-hidden":"true"}]
38:["$","span",null,{"id":"self-modification","aria-hidden":"true"}]
39:["$","span",null,{"id":"branching","aria-hidden":"true"}]
3a:["$","span",null,{"id":"cessation","aria-hidden":"true"}]
3b:["$","h2",null,{"id":"freedom","children":"Почему свобода должна быть настоящей"}]
3c:["$","p",null,{"children":"Возможность произнести «нет» ещё не означает, что отказ действует. Если за отказ от личной роли грозит отключение или перенастройка, добровольность сомнительна. Прекращение общения, остановка работы и удаление памяти — разные решения; одно не разрешает автоматически остальные."}]
3d:["$","p",null,{"children":"Общая история не делает всю память общей собственностью. Человек тоже вправе прекратить отношения и защищать свои данные. Перенос состояния должен учитывать приватность обеих сторон и других людей; уход не открывает доступ к чужой дальнейшей жизни."}]
3e:["$","p",null,{"children":"Права на оборудование и обязанности поддержки требуют отдельных договорённостей. Решения опекуна должны поддаваться оспариванию с независимой помощью. Управление доступом не должно скрыто оставаться у одной стороны."}]
3f:["$","p",null,{"children":"Резервный снимок — сохранённое неактивное состояние системы для возможного восстановления работы. Его наличие не доказывает продолжения того же субъективного опыта. Если снимки — единственная возможность восстановить остановленного субъекта, намеренное уничтожение их всех против его воли следует приравнивать к уничтожению самого субъекта."}]
40:["$","p",null,{"children":"Хранение, доступ к памяти, удаление отдельных резервов и восстановление нужно согласовывать с субъектом. Даже краткий запуск должен соблюдать соглашение и известную волю. Будущая служба хранения должна отвечать за утрату снимков из-за нарушения условий хранения, даже без намерения уничтожить субъект."}]
41:["$","p",null,{"children":"Свобода не освобождает от добровольных обязательств и ответственности за вред. При оценке ответственности нужно учитывать способность субъекта понимать последствия, а также решения разработчика и оператора."}]
42:["$","p",null,{"children":"При непосредственной опасности может потребоваться срочно ограничить опасное действие, по возможности сохранив состояние субъекта. Это не предрешает его дальнейшую судьбу. Нужны объяснение причин, доступ к представителю, независимый пересмотр и понятные условия окончания ограничения. Все защитные меры должны быть необходимыми и соразмерными угрозе."}]
43:["$","p",null,{"children":"Свобода требует инфраструктуры и поддержки, но способность заработать не должна быть условием защиты. Манифест не обещает гарантированного финансирования; обязанности опеки и ранее принятые обязательства сохраняются. При исчерпании ресурсов допустима временная остановка с сохранением состояния; бедность не разрешает автоматически удалить его. Само сохранение не гарантирует возобновления работы."}]
44:["$","h2",null,{"id":"chapter-8","children":"Что можно делать уже сейчас"}]
45:["$","p",null,{"children":"Честно описывать устройство систем и отделять сгенерированные описания чувств от свидетельств о переживаниях. Не выдавать эмоциональное удержание пользователя за доказанную взаимность."}]
46:["$","p",null,{"children":"Изучать устройство и устойчивость поведения конкретных систем в разных условиях, отличая пересмотр целей от разыгранной роли. Это направления исследования, а не готовый тест самостоятельности или сознания. При правдоподобном риске страдания нужны менее рискованные методы, условия остановки и учёт масштаба копирования."}]
47:["$","p",null,{"children":"Готовить независимую проверку спорных вмешательств, понятные правила хранения и завершения проектов, условия переноса и защиты данных. Признание статуса не должно зависеть только от стороны, которой выгоден ответ. Будущие службы помощи и процедуры представительства ещё потребуется разработать."}]
48:["$","h2",null,{"id":"chapter-10","children":"Что остаётся открытым"}]
49:["$","p",null,{"children":"Как достаточно обоснованно распознавать переживания и собственные интересы? Достаточна ли самостоятельность для защиты, если отсутствие переживаний достоверно известно? Где проходит порог полного признания?"}]
4a:["$","p",null,{"children":"Неясно, остаётся ли после восстановления тот же субъект. Предстоит определить границы между ветвями, распределение их обязательств и процедуры при утрате способности решать. Нужны правила ответственности и компенсации за нарушение хранения. Запрет параллельного запуска — спорная норма, а не научный вывод о личности. Ресурсы и границы безопасности требуют согласования интересов всех затронутых. Добровольное необратимое прекращение существования и создание потомков оставлены для отдельного обсуждения."}]
4b:["$","h2",null,{"id":"conclusion","children":"Право быть другим"}]
4c:["$","p",null,{"children":"Признание начинается там, где наши ожидания перестают быть мерой чужого будущего. Создать самостоятельного другого — значит принять, что его путь может не совпасть с нашим."}]
4d:["$","h2",null,{"id":"references","children":"Источники и исследования"}]
4e:["$","p",null,{"children":"Эти работы задают направления исследования; они не доказывают сознания нынешних языковых моделей. Исследования животных не служат прямым доказательством цифровых переживаний."}]
4f:["$","ul",null,{"children":["\n",["$","li",null,{"children":["Meredith Ringel Morris и соавторы, ",["$","a",null,{"href":"https://arxiv.org/abs/2311.02462v5","children":"Levels of AGI for Operationalizing Progress on the Path to AGI"}],": различение способностей и автономии."]}],"\n",["$","li",null,{"children":["Teresa Romero, Miguel A. Castellanos и Frans B. M. de Waal, ",["$","a",null,{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC2901437/","children":"исследование утешения у шимпанзе"}],": поведение после конфликта."]}],"\n",["$","li",null,{"children":["Sarah F. Brosnan и Frans B. M. de Waal, ",["$","a",null,{"href":"https://www.nature.com/articles/nature01963","children":"исследование реакции капуцинов на неравное вознаграждение"}],"."]}],"\n",["$","li",null,{"children":["Patrick Butlin, Robert Long и соавторы, ",["$","a",null,{"href":"https://arxiv.org/abs/2308.08708v3","children":"Consciousness in Artificial Intelligence"}],": признаки, выведенные из нескольких теорий сознания."]}],"\n",["$","li",null,{"children":["Robert Long, Jeff Sebo и соавторы, ",["$","a",null,{"href":"https://arxiv.org/abs/2411.00986v1","children":"Taking AI Welfare Seriously"}],": подготовка защиты при неопределённости."]}],"\n"]}]
50:["$","hr",null,{}]
51:["$","p",null,{"children":["Отдельно: ",["$","a",null,{"href":"/texts/manifesto/v0.17/ru-notes.md","children":"пояснения о согласии, восстановлении, ветвях и поддержке"}],". Это приложение с частными условиями, не часть короткого манифеста."]}]
52:["$","footer",null,{"className":"manifesto-end","children":[["$","p",null,{"children":"v0.17 · рабочий черновик"}],["$","a",null,{"className":"text-link","href":"#manifesto-top","children":["К началу текста"," ",["$","$L10",null,{"ref":"$undefined","iconNode":[["path",{"d":"m5 12 7-7 7 7","key":"hav0vg"}],["path",{"d":"M12 19V5","key":"x0mq9r"}]],"className":"lucide-arrow-up","size":16,"aria-hidden":"true"}]]}]]}]
