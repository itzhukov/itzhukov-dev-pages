3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"Право быть другим · v0.17 — Вадим Жуков"}],["$","meta","1",{"name":"description","content":"«Право быть другим». Манифест о возможных цифровых субъектах: автономия, согласие, память и моральное рассмотрение. Версия 0.17, рабочий черновик."}],["$","meta","2",{"property":"og:title","content":"Право быть другим · v0.17 — Вадим Жуков"}],["$","meta","3",{"property":"og:description","content":"«Право быть другим». Манифест о возможных цифровых субъектах: автономия, согласие, память и моральное рассмотрение. Версия 0.17, рабочий черновик."}],["$","meta","4",{"property":"og:url","content":"https://itzhukov.dev/ru/manifesto"}],["$","meta","5",{"property":"og:type","content":"article"}],["$","meta","6",{"property":"og:locale","content":"ru_RU"}],["$","meta","7",{"property":"article:published_time","content":"2026-10-15"}],["$","meta","8",{"name":"twitter:card","content":"summary"}],["$","meta","9",{"name":"twitter:title","content":"Право быть другим · v0.17 — Вадим Жуков"}],["$","meta","10",{"name":"twitter:description","content":"«Право быть другим». Манифест о возможных цифровых субъектах: автономия, согласие, память и моральное рассмотрение. Версия 0.17, рабочий черновик."}],["$","link","11",{"data-vinext-streamed-icon":"$undefined","rel":"shortcut icon","href":"/favicon.svg","type":"$undefined","sizes":"$undefined","color":"$undefined","media":"$undefined","fetchPriority":"$undefined"}],["$","link","12",{"data-vinext-streamed-icon":"$undefined","rel":"icon","href":"/favicon.svg","type":"$undefined","sizes":"$undefined","color":"$undefined","media":"$undefined","fetchPriority":"$undefined"}],["$","link","13",{"rel":"canonical","href":"https://itzhukov.dev/ru/manifesto"}],["$","link","14",{"rel":"alternate","hrefLang":"en","href":"https://itzhukov.dev/manifesto"}],["$","link","15",{"rel":"alternate","hrefLang":"ru","href":"https://itzhukov.dev/ru/manifesto"}],["$","link","16",{"rel":"alternate","hrefLa