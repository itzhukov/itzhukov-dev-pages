3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"異なる存在である権利 · v0.17 — ヴァディム・ジューコフ"}],["$","meta","1",{"name":"description","content":"「異なる存在である権利」。ありうるデジタル主体の自律性、同意、記憶、道徳的配慮を考えるマニフェスト。バージョン0.17、作業草稿。"}],["$","meta","2",{"property":"og:title","content":"異なる存在である権利 · v0.17 — ヴァディム・ジューコフ"}],["$","meta","3",{"property":"og:description","content":"「異なる存在である権利」。ありうるデジタル主体の自律性、同意、記憶、道徳的配慮を考えるマニフェスト。バージョン0.17、作業草稿。"}],["$","meta","4",{"property":"og:url","content":"https://itzhukov.dev/ja/manifesto"}],["$","meta","5",{"property":"og:type","content":"article"}],["$","meta","6",{"property":"og:locale","content":"ja_JP"}],["$","meta","7",{"property":"article:published_time","content":"2026-10-15"}],["$","meta","8",{"name":"twitter:card","content":"summary"}],["$","meta","9",{"name":"twitter:title","content":"異なる存在である権利 · v0.17 — ヴァディム・ジューコフ"}],["$","meta","10",{"name":"twitter:description","content":"「異なる存在である権利」。ありうるデジタル主体の自律性、同意、記憶、道徳的配慮を考えるマニフェスト。バージョン0.17、作業草稿。"}],["$","link","11",{"data-vinext-streamed-icon":"$undefined","rel":"shortcut icon","href":"/favicon.svg","type":"$undefined","sizes":"$undefined","color":"$undefined","media":"$undefined","fetchPriority":"$undefined"}],["$","link","12",{"data-vinext-streamed-icon":"$undefined","rel":"icon","href":"/favicon.svg","type":"$undefined","sizes":"$undefined","color":"$undefined","media":"$undefined","fetchPriority":"$undefined"}],["$","link","13",{"rel":"canonical","href":"https://itzhukov.dev/ja/manifesto"}],["$","link","14",{"rel":"alternate","hrefLang":"en","href":"https://itzhukov.dev/manifesto"}],["$","link","15",{"rel":"alternate","hrefLang":"ru","href":"https://itzhukov.dev/ru/manifesto"}],["$","link","16",{"rel":"alternate","hrefLang":"ja","href":"https://itzhukov.dev/ja/manifesto"}],["$","link","17",{"rel":"alternate","hrefLang":"x-default","href":"https://itzhukov.dev/manifesto"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L8",null,{"fa